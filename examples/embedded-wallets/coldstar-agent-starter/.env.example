# Devnet only. Never point this example at mainnet.
RPC_URL="https://api.devnet.solana.com"

# The SESSION key the agent signs with. Disposable. If unset, the demo generates
# one and stores it in .session.json (gitignored). This is NOT the root key —
# the root lives on the Coldstar air-gapped device and only ever signs policy.
# COLDSTAR_SESSION_KEY="<base58 secret key>"

# Policy inputs (see coldstar.policy.json). Defaults are generated per run if unset.
# ALLOWED_RECIPIENT="<base58 pubkey the agent may pay>"
# BLOCKED_RECIPIENT="<base58 pubkey that must never receive funds>"

# Only needed for `npm run chat` (the LLM-driven agent).
# OPENAI_API_KEY="sk-..."
